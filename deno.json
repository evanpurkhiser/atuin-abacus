{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run --unstable-temporal --allow-net --allow-env --allow-read --watch src/main.ts",
    "start": "deno run --unstable-temporal --allow-net --allow-env --allow-read src/main.ts",
    "test": "./scripts/test.sh",
    "test:watch": "./scripts/test.sh --watch",
    "lint": "deno run -A npm:oxlint@^1.56.0 src test scripts",
    "lint:fix": "deno run -A npm:oxlint@^1.56.0 --fix src test scripts",
    "format": "deno run -A npm:oxfmt@^0.41.0 --write .",
    "format:check": "deno run -A npm:oxfmt@^0.41.0 --check ."
  },
  "imports": {
    "@evanpurkhiser/oxc-config": "npm:@evanpurkhiser/oxc-config@^0.5.0",
    "@sentry/deno": "npm:@sentry/deno@^10",
    "@std/dotenv": "jsr:@std/dotenv@^0.225",
    "@std/assert": "jsr:@std/assert@^1",
    "oxfmt": "npm:oxfmt@^0.41.0",
    "oxlint": "npm:oxlint@^1.56.0",
    "postgres": "https://deno.land/x/postgres@v0.19.3/mod.ts",
    "hono": "jsr:@hono/hono@^4"
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 100
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
