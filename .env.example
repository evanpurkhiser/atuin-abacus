# API Configuration
PORT=8000
HOST=127.0.0.1

# Cache Configuration
# Cache TTL in seconds (default: 300 = 5 minutes)
CACHE_TTL_SECONDS=300

# Embedded Atuin sync and local projections
ATUIN_SYNC_INTERVAL_SECONDS=300
ABACUS_DATA_DIR=.local/atuin-abacus

# Atuin reads its server address, authentication, and encryption key from the
# standard client configuration. Set this when the mounted configuration lives
# outside the default XDG path.
# ATUIN_HOME=/run/atuin

# Error Monitoring (Sentry)
# Leave unset to disable reporting (e.g. local development)
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
